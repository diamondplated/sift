#!/bin/bash
# Open a file in Sift, starting the engine if it isn't already up.
#
# Repeated invocations hand off to the running engine (single-instance logic in app.py):
#   sift-open sales.csv
#   sift-open ~/data/events/          # a folder of parquet, or a Delta table
#
# app.py realpath()s every path itself, and exec preserves our cwd, so relative args resolve
# correctly without help. First call with no instance running blocks serving the app (what we
# want for the first drop); later calls hand off over HTTP and return immediately.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ! -x "$HERE/.venv/bin/python" ]]; then
  echo "sift: no venv at $HERE/.venv — see $HERE/dev.sh for the setup command" >&2
  exit 1
fi

exec "$HERE/.venv/bin/python" "$HERE/engine/app.py" "$@"
